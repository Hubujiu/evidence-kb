{
  "version": 1,
  "application_id": "knowledge-production",
  "routes": {
    "content": {"provider": "postgresql", "url_env": "KB_CONTENT_DATABASE_URL", "migration_url_env": "KB_CONTENT_MIGRATION_URL"},
    "vectors": {"provider": "postgresql", "url_env": "KB_VECTOR_DATABASE_URL", "migration_url_env": "KB_VECTOR_MIGRATION_URL"},
    "conversations": {"provider": "mysql", "url_env": "KB_SESSION_DATABASE_URL", "migration_url_env": "KB_SESSION_MIGRATION_URL"}
  },
  "bindings": {
    "repository": {"primary": {"route": "content", "owner": "knowledge", "space": "content"}},
    "search_bm25": {"primary": {"route": "content", "owner": "knowledge", "space": "content"}},
    "search_dense": {"primary": {"route": "vectors", "owner": "knowledge-search", "space": "vectors"}},
    "store": {"primary": {"route": "conversations", "owner": "conversations", "space": "history"}}
  }
}
