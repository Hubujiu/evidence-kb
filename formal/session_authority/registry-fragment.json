{
  "schema_version": 1,
  "machines": [
    {
      "id": "session_commit",
      "status": "partial",
      "owners": [
        "kb_platform/session_store.py"
      ],
      "states": [
        "Request absent/running/interrupted/complete",
        "Live or expired lease predicate",
        "Session revision and completion-event sequence",
        "Optional assistant event and durable response/state",
        "Client observation none/pending/unknown/known",
        "Finish transaction row lock"
      ],
      "transitions": [
        "Begin fresh request with revision; supersede expired predecessor",
        "Expire; append under admitted lease",
        "Prepare success or failure; atomic commit or precommit rollback",
        "Receive or lose committed reply; same-fingerprint completed replay"
      ],
      "invariants": [
        "TypeOK",
        "SingleWriter",
        "NoSupersededCompletion",
        "AtomicCompletion",
        "RevisionOrder",
        "SuccessfulAdmission",
        "FailureAdmission",
        "KnownMeansComplete",
        "ReplayIdentity",
        "AppendAdmission"
      ],
      "assumptions": [
        "One immutable session owner already authenticated; distinct request identities represent unique generated lease tokens",
        "Session-row writer exclusion and atomic commit/rollback are provided by the structured database adapter",
        "The lease predicate is sampled under the session row lock; subsequent expiration does not undo admission",
        "Two request identities and two fingerprints; stuttering models rejected calls; no fairness or liveness guarantee"
      ],
      "exclusions": [
        "Multiple-session scheduling, UUID collision and wall-clock rollback",
        "SQL/provider isolation implementation and physical power-loss recovery",
        "Artifacts, arbitrary event payloads, export/import validation and domain failure-shape validation",
        "No claim of native runtime, model billing or RAG quality verification"
      ],
      "remaining_obligations": [
        "Model session owner/tenant identity decisions, artifact lifecycle and transfer/export/import state",
        "Validate provider-specific concurrency and commit ambiguity for PostgreSQL/MySQL independently",
        "Unbounded identifiers and progress/fairness are not established by bounded TLC"
      ],
