        "Complete/error and remembered authorization-at-commit witness"
      ],
      "transitions": [
        "Preflight authorization; native completion",
        "Post-native execution guard; original authority revision comparison; evidence revalidation",
        "State construction; final execution guard; separate session commit",
        "Current evidence revalidation on completed-request replay",
        "One concurrent authority mutation and cancellation"
      ],
      "invariants": [
        "TypeOK",
        "FreshResponseWasChecked",
        "ReplayResponseWasRevalidated"
      ],
      "assumptions": [
        "Successful gateway validation is abstracted at its check point; internal read/revision correctness is separate",
        "The session commit contract is modeled separately, not a proved composition or shared transaction",
        "Finite authorization/cancellation environment; runtime/provider effects and failure payloads omitted"
      ],
      "exclusions": [
        "Knowledge authority publication/build/membership state machine and storage implementation",
        "Cross-store serializability, revocation-at-commit guarantee or cancellation after the final check",
        "Citation content, policy selection, failure-response redaction, provider budgets and native workflow internals"
      ],
      "remaining_obligations": [
        "Model authority publication/build states separately; this entry must not mark authority_publication as covered",
        "Establish internal gateway validation consistency and shared authority revision protocol",
        "Define and implement any stronger cross-store authorization-at-commit requirement before claiming it"
